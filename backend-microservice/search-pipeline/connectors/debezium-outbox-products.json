{
  "name": "catalog-products-outbox-source",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "dbz",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "database.server.id": "184054",
    "topic.prefix": "ecommerce_catalog_products_cdc_v4",
    "database.include.list": "ecommerce_catalog",
    "table.include.list": "ecommerce_catalog.outbox",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
    "schema.history.internal.kafka.topic": "schema-changes.ecommerce_catalog.products.v4",
    "snapshot.mode": "initial",
    "include.schema.changes": "false",
    "skipped.operations": "u,d",
    "tombstones.on.delete": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.by.field": "aggregate_type",
    "transforms.outbox.route.topic.replacement": "outbox.event.${routedByValue}",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.route.tombstone.on.empty.payload": "true",
    "transforms.outbox.table.fields.additional.placement": "event_type:header:eventType,created_at:header:createdAt"
  }
}
