{
  "name": "products-elasticsearch-sink",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
    "tasks.max": "1",
    "topics": "outbox.event.Product",
    "external.resource.usage": "alias_index",
    "topic.to.external.resource.mapping": "outbox.event.Product:products",
    "connection.url": "http://elasticsearch:9200",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "key.ignore": "false",
    "schema.ignore": "true",
    "write.method": "UPSERT",
    "behavior.on.null.values": "DELETE",
    "behavior.on.malformed.documents": "IGNORE",
    "drop.invalid.message": "true",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq.products.elasticsearch",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "max.in.flight.requests": "1",
    "batch.size": "200",
    "linger.ms": "100"
  }
}
