{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "normalizer": {
        "lowercase_keyword": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },
      "code": { "type": "keyword" },
      "sellerId": { "type": "keyword" },
      "name": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "normalizer": "lowercase_keyword" }
        }
      },
      "description": { "type": "text" },
      "status": { "type": "keyword" },
      "categoryId": { "type": "keyword" },
      "categoryName": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "normalizer": "lowercase_keyword" }
        }
      },
      "categorySlug": { "type": "keyword", "normalizer": "lowercase_keyword" },
      "imageUrl": { "type": "keyword", "index": false },
      "ratingAverage": { "type": "double" },
      "ratingCount": { "type": "long" },
      "attributes": {
        "type": "nested",
        "properties": {
          "definitionId": { "type": "keyword" },
          "name": { "type": "text" },
          "dataType": { "type": "keyword" },
          "valueText": { "type": "text" },
          "valueNumber": { "type": "double" },
          "unit": { "type": "keyword", "normalizer": "lowercase_keyword" },
          "optionIds": { "type": "keyword" },
          "optionValues": { "type": "keyword", "normalizer": "lowercase_keyword" }
        }
      },
      "variants": {
        "type": "nested",
        "properties": {
          "id": { "type": "keyword" },
          "sku": { "type": "keyword" },
          "combinationKey": { "type": "keyword" },
          "salePrice": { "type": "double" },
          "quantity": { "type": "integer" },
          "imageUrl": { "type": "keyword", "index": false },
          "isDefault": { "type": "boolean" },
          "status": { "type": "keyword" },
          "selections": {
            "type": "nested",
            "properties": {
              "axisId": { "type": "keyword" },
              "axisName": { "type": "keyword", "normalizer": "lowercase_keyword" },
              "valueId": { "type": "keyword" },
              "value": { "type": "keyword", "normalizer": "lowercase_keyword" }
            }
          }
        }
      }
    }
  }
}
