{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "vi_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "normalizer": {
        "lowercase_keyword": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "_meta": {
      "schema_version": 3,
      "description": "Vietnamese diacritic-insensitive full text, autocomplete and single-select facets"
    },
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },
      "code": { "type": "keyword" },
      "sellerId": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "vi_search",
        "search_analyzer": "vi_search",
        "fields": {
          "keyword": { "type": "keyword", "normalizer": "lowercase_keyword" },
          "autocomplete": { "type": "search_as_you_type", "analyzer": "vi_search", "max_shingle_size": 3 }
        }
      },
      "description": { "type": "text", "analyzer": "vi_search", "search_analyzer": "vi_search" },
      "status": { "type": "keyword" },
      "categoryId": { "type": "keyword" },
      "categoryName": {
        "type": "text",
        "analyzer": "vi_search",
        "search_analyzer": "vi_search",
        "fields": {
          "keyword": { "type": "keyword", "normalizer": "lowercase_keyword" },
          "autocomplete": { "type": "search_as_you_type", "analyzer": "vi_search", "max_shingle_size": 3 }
        }
      },
      "categorySlug": { "type": "keyword", "normalizer": "lowercase_keyword" },
      "imageUrl": { "type": "keyword", "index": false },
      "ratingAverage": { "type": "double" },
      "ratingCount": { "type": "long" },
      "createdAt": { "type": "long" },
      "attributes": {
        "type": "nested",
        "properties": {
          "definitionId": { "type": "keyword" },
          "name": { "type": "text", "analyzer": "vi_search" },
          "dataType": { "type": "keyword" },
          "valueText": { "type": "text", "analyzer": "vi_search" },
          "valueNumber": { "type": "double" },
          "unit": { "type": "keyword", "normalizer": "lowercase_keyword" },
          "optionIds": { "type": "keyword" },
          "optionValues": { "type": "keyword", "normalizer": "lowercase_keyword" }
        }
      },
      "variants": {
        "type": "nested",
        "properties": {
          "id": { "type": "keyword" },
          "sku": { "type": "keyword" },
          "combinationKey": { "type": "keyword" },
          "salePrice": { "type": "double" },
          "quantity": { "type": "integer" },
          "imageUrl": { "type": "keyword", "index": false },
          "isDefault": { "type": "boolean" },
          "status": { "type": "keyword" },
          "selections": {
            "type": "nested",
            "properties": {
              "axisId": { "type": "keyword" },
              "axisName": { "type": "keyword", "normalizer": "lowercase_keyword" },
              "valueId": { "type": "keyword" },
              "value": { "type": "keyword", "normalizer": "lowercase_keyword" }
            }
          }
        }
      }
    }
  }
}
